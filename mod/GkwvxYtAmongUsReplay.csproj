<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>GkwvxYtAmongUsReplay</AssemblyName>
    <RootNamespace>GkwvxYtMods.Mod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.reactor.gg/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.697" IncludeAssets="compile" />
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="2024.10.29" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\src\ModelosReplay.cs" Link="Replay\ModelosReplay.cs" />
    <Compile Include="..\src\NdjsonReplayStorage.cs" Link="Replay\NdjsonReplayStorage.cs" />
    <Compile Include="..\src\GravadorReplaySessao.cs" Link="Replay\GravadorReplaySessao.cs" />
    <Compile Include="..\src\Plugin.cs" Link="Plugin.cs" />
    <!-- Se estiver em src/Replay/ReplayPatches.cs, use a linha abaixo: -->
    <Compile Include="..\src\Replay\ReplayPatches.cs" Link="Replay\ReplayPatches.cs" />
    <!-- (Se a pasta Replay estiver na raiz do repo, troque acima por: ..\Replay\ReplayPatches.cs) -->
  </ItemGroup>

</Project>
